def apply_v270_toolbar_rows(root):
    """Toolbar Layout Controller: move native view tabs plus PROFILE/WATCHLIST controls to row 2."""
    ap=root/'app.js'
    if not ap.exists(): return
    js=ap.read_text(encoding='utf-8')
    if 'v270ViewRow' in js: return
    js += r"""
function v270ToolbarRows(){
 const labels=['SCANNER','ORDER FLOW','CHART','FOOTPRINT','VOLUME PROFILE','TPO'];
 const buttons=[...document.querySelectorAll('button')];
 const views=labels.map(n=>buttons.find(b=>(b.textContent||'').trim().toUpperCase()===n)).filter(Boolean);
 if(views.length<6)return;
 const nativeParent=views[0].parentElement;if(!nativeParent)return;
 let row=document.getElementById('v270ViewRow');
 if(!row){row=nativeParent.cloneNode(false);row.id='v270ViewRow';row.removeAttribute('style');nativeParent.parentNode.insertBefore(row,nativeParent.nextSibling)}
 views.forEach(b=>row.appendChild(b));
 // PROFILE and WATCHLIST are compound native controls; move their complete wrappers, not only inner buttons.
 ['PROFILE','WATCHLIST'].forEach(name=>{
   const b=buttons.find(x=>(x.textContent||'').trim().toUpperCase()===name);
   if(!b)return;
   let unit=b;
   while(unit.parentElement && unit.parentElement!==nativeParent && unit.parentElement.children.length<=4) unit=unit.parentElement;
   if(unit===nativeParent) unit=b;
   row.appendChild(unit);
 });
}
setTimeout(v270ToolbarRows,50);
setTimeout(v270ToolbarRows,700);
"""
    ap.write_text(js,encoding='utf-8')

