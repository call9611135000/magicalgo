def _version_number(value):
    try: return int(str(value).strip().upper().lstrip('V'))
    except Exception: return 0

def _launcher_version(data):
    try:
        head=data[:16384].decode('utf-8-sig',errors='ignore')
        for line in head.splitlines():
            line=line.strip()
            if not line.startswith('VERSION'): continue
            left,sep,right=line.partition('=')
            if sep and left.strip()=='VERSION':
                value=right.strip().strip('"').strip("'")
                if value.upper().startswith('V') and value[1:].isdigit(): return value.upper()
    except Exception: pass
    return ''

def check_github_update():
    """Filename-independent GitHub-direct updater with stage-by-stage diagnostics."""
    if os.environ.get('MAGIC_ALGO_SKIP_UPDATE') == '1': return False
    log=Path(sys.argv[0]).resolve().parent / "MAGIC_ALGO_UPDATE.log"
    def note(msg):
        try:
            with log.open('a',encoding='utf-8') as f:
                f.write(time.strftime('%Y-%m-%d %H:%M:%S')+' | '+msg+'\n')
        except Exception: pass
    try:
        target=Path(sys.argv[0]).resolve()
        note('START local='+VERSION+' target='+str(target))
        nonce=str(int(time.time()))
        url=GITHUB_LAUNCHER_URL+'?t='+nonce
        note('FETCH '+url)
        req=urllib.request.Request(url,headers={'User-Agent':'MAGIC-ALGO-Updater','Cache-Control':'no-cache','Pragma':'no-cache'})
        with urllib.request.urlopen(req,timeout=15) as response: data=response.read()
        remote=_launcher_version(data)
        note('REMOTE version='+str(remote)+' bytes='+str(len(data))+' sha256='+hashlib.sha256(data).hexdigest())
        if not remote:
            note('STOP remote VERSION not found'); return False
        if _version_number(remote) <= _version_number(VERSION):
            note('CURRENT no update required'); return False
        compile(data.decode('utf-8-sig'),GITHUB_LAUNCHER_URL,'exec')
        note('VALID syntax OK')
        if not target.is_file():
            note('STOP target is not a file'); return False
        staged=Path(tempfile.gettempdir())/('MAGIC_ALGO_'+remote+'_'+str(os.getpid())+'.pyw')
        staged.write_bytes(data)
        note('STAGED '+str(staged))
        helper=Path(tempfile.gettempdir())/('magic_algo_apply_update_'+str(os.getpid())+'.py')
        helper.write_text(
            "import os,sys,time,subprocess\n"
            "pid=int(sys.argv[1]); target=sys.argv[2]; staged=sys.argv[3]; exe=sys.argv[4]; log=sys.argv[5]; remote=sys.argv[6]\n"
            "def note(m):\n"
            " try:\n"
            "  with open(log,'a',encoding='utf-8') as f:f.write(time.strftime('%Y-%m-%d %H:%M:%S')+' | '+m+'\\n')\n"
            " except Exception:pass\n"
            "note('HELPER target='+target+' remote='+remote)\n"
            "time.sleep(1.0)\n"
            "ok=False\n"
            "for n in range(120):\n"
            " try:\n"
            "  os.replace(staged,target);ok=True;note('REPLACED attempt='+str(n+1));break\n"
            " except Exception as e:\n"
            "  if n in (0,9,39,79,119):note('REPLACE_WAIT '+repr(e))\n"
            "  time.sleep(.25)\n"
            "if ok:\n"
            " env=os.environ.copy();env['MAGIC_ALGO_SKIP_UPDATE']='1'\n"
            " try:\n"
            "  subprocess.Popen([exe,target],env=env,creationflags=0x08000000 if os.name=='nt' else 0);note('RELAUNCH requested '+remote)\n"
            " except Exception as e:note('RELAUNCH_ERROR '+repr(e))\n"
            "else:note('FAILED replacement')\n",
            encoding='utf-8')
        subprocess.Popen([sys.executable,str(helper),str(os.getpid()),str(target),str(staged),sys.executable,str(log),remote],
                         creationflags=0x08000000 if os.name=='nt' else 0)
        note('HANDOFF helper='+str(helper))
        return True
    except Exception as exc:
        note('ERROR '+repr(exc))
        return False

def find_magic_window():
    if os.name != 'nt': return (0,'')
    u=ctypes.windll.user32; found=[0,'']
    @ctypes.WINFUNCTYPE(ctypes.c_bool,ctypes.c_void_p,ctypes.c_void_p)
    def cb(hwnd,lparam):
        if not u.IsWindowVisible(hwnd): return True
        n=u.GetWindowTextLengthW(hwnd)
        if n<=0: return True
        b=ctypes.create_unicode_buffer(n+1); u.GetWindowTextW(hwnd,b,n+1)
        if b.value.startswith('MAGIC ALGO'):
            found[0]=hwnd; found[1]=b.value; return False
        return True
    try: u.EnumWindows(cb,0)
    except Exception: pass
    return tuple(found)

def activate(hwnd):
    if os.name=='nt' and hwnd:
        try: ctypes.windll.user32.ShowWindow(hwnd,9); ctypes.windll.user32.SetForegroundWindow(hwnd)
        except Exception: pass

def close_older_magic_windows():
    """Close older MAGIC ALGO MARKET PROFILE windows before this build starts."""
    if os.name != 'nt': return
    import re, time
    u = ctypes.windll.user32
    current = int(VERSION.lstrip('Vv') or '0')
    targets = []
    @ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)
    def cb(hwnd, lparam):
        if not u.IsWindowVisible(hwnd): return True
        n = u.GetWindowTextLengthW(hwnd)
        if n <= 0: return True
        b = ctypes.create_unicode_buffer(n + 1); u.GetWindowTextW(hwnd, b, n + 1)
        title = b.value
        if title.startswith('MAGIC ALGO') and 'MARKET PROFILE' in title:
            m = re.search(r'\bV(\d+)\b', title, re.I)
            if (m and int(m.group(1)) < current) or (not m):
                targets.append(hwnd)
        return True
    try: u.EnumWindows(cb, 0)
    except Exception: return
    for hwnd in targets:
        try: u.PostMessageW(hwnd, 0x0010, 0, 0)  # WM_CLOSE
        except Exception: pass
    if targets:
        deadline = time.time() + 3.0
        while time.time() < deadline and any(u.IsWindow(h) for h in targets):
            time.sleep(0.08)

def release_market_profile_port():
    """Stop a stale detached MARKET PROFILE HTTP server left by an older build."""
    if os.name != 'nt': return
    try:
        out=subprocess.check_output(['netstat','-ano','-p','tcp'], text=True, errors='ignore', creationflags=0x08000000)
        pids=set()
        for line in out.splitlines():
            parts=line.split()
            if len(parts)>=5 and parts[0].upper()=='TCP' and any(parts[1].endswith(':'+str(p)) for p in (8765,9139,9140,9141,9142,9143,9144,9145,9146,9147,9148,9149,9150,9151,9152,9153,9154,9155,9156,9157,9158,9159,9160,9161,9162,9163,9164,9165,9166,9167,9168,9169,9170,9171,9172,9173,9174,9176,9177,9178,9179,9180,9181,9182,9183,9184,9185,9186,9187,9188,9189,9190,9191,9192,9193,9194,9195,9196,9197,9198)) and parts[3].upper()=='LISTENING':
                if parts[4].isdigit(): pids.add(parts[4])
        for pid in pids:
            subprocess.run(['taskkill','/PID',pid,'/F','/T'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, creationflags=0x08000000)
        if pids: time.sleep(0.5)
    except Exception:
        pass

def single_instance():
    global _MUTEX
    if os.name!='nt': return True
    k32=ctypes.windll.kernel32
    _MUTEX=k32.CreateMutexW(None,False,'Local\\MAGIC_ALGO_SINGLE_INSTANCE_V270')
    if k32.GetLastError()==183:
        hwnd,_=find_magic_window(); activate(hwnd)
        return False
    return True


