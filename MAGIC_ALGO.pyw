# V270: unavoidable fixed values must be declared here, never scattered through modules.
# Empty by design: existing native/reference-driven values are preferred and no new hardcode is introduced.
HARDCODE_REGISTRY = {}

def hardcode_manifest():
    return {k: dict(v) if isinstance(v, dict) else v for k,v in HARDCODE_REGISTRY.items()}

def controller_manifest():
    return {k: dict(v) for k,v in CONTROLLERS.items()}

def deploy_own_build():
    RUNTIME.parent.mkdir(parents=True,exist_ok=True)
    tmp=Path(tempfile.mkdtemp(prefix='ma257_',dir=str(RUNTIME.parent)))
    try:
        with zipfile.ZipFile(io.BytesIO(base64.b64decode(PAYLOAD))) as z: z.extractall(tmp)
        apply_angel_status_patch(tmp)
        apply_v270_native_replay(tmp)
        apply_v270_toolbar_rows(tmp)
        try: (tmp/'magic_algo_version.txt').write_text(VERSION+'\n',encoding='utf-8')
        except Exception: pass
        if RUNTIME.exists(): shutil.rmtree(RUNTIME,ignore_errors=True)
        tmp.replace(RUNTIME)
    except Exception:
        shutil.rmtree(tmp,ignore_errors=True); raise

def main():
    if check_github_update(): return
    if os.name=='nt':
        try: ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID('MagicAlgo.MarketProfile.Setup')
        except Exception: pass
    close_older_magic_windows()
    release_market_profile_port()
    if not single_instance(): return
    deploy_own_build()
    os.chdir(RUNTIME)
    runpy.run_path(str(RUNTIME/'MARKET_PROFILE_GUI.pyw'),run_name='__main__')

if __name__=='__main__':
    try:
        main()
    except Exception:
        import traceback
        err=traceback.format_exc()
        try:
            log=Path(os.environ.get("TEMP", str(Path.home()))) / "MAGIC_ALGO_V270_STARTUP_ERROR.txt"
            log.write_text(err,encoding="utf-8")
        except Exception:
            pass
        if os.name=='nt':
            try: ctypes.windll.user32.MessageBoxW(0,err,"MAGIC ALGO V270 - Startup Error",0x10)
            except Exception: pass
        raise
